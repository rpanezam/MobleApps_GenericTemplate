# ==============================================================================
# App Factory - Monorepo Environment Variables Example
# Copy this file to a local '.env' file and configure the credentials accordingly.
# Note: Do not commit the actual '.env' file containing secrets to version control.
# ==============================================================================

# Supabase Configurations
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Firebase Configurations
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_APP_ID=your_firebase_app_id_here

# Stripe Payments (Monthly/Annual Subscriptions)
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# AdMob (Advertising Platform)
ADMOB_APP_ID=your_admob_app_id_here

# Unified Backend Database (ASP.NET Core / Prisma PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_factory_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Redis Cache url
REDIS_URL=redis://localhost:6379
